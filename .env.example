# Salin file ini menjadi .env.local lalu isi nilainya. JANGAN commit .env.local.

# --- Database (PostgreSQL: Supabase / Neon) ---
DATABASE_URL=postgres://user:pass@host:5432/db

# --- Supabase (Realtime untuk layar sambutan check-in) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# aman dipakai di browser (prefix NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA, hanya di server
SUPABASE_SERVICE_ROLE_KEY=

# --- Rahasia aplikasi ---
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# untuk tanda tangan cookie & HMAC QR
TOKEN_SECRET=

# --- URL publik aplikasi (untuk link WA, QR, OG image) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
